<Project Sdk="Microsoft.NET.Sdk">

  <!-- 纯逻辑自检：不引用游戏程序集、不进游戏，dotnet run 即可跑。
       链接源码而不是引用 dll —— 这样测的就是真正被打进 mod 的那份实现。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MegaTank.PureCheck</AssemblyName>
    <RootNamespace>MegaTank.PureCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\Core\WaterMath.cs" Link="WaterMath.cs" />
    <Compile Include="..\..\src\Core\Ids.cs" Link="Ids.cs" />
  </ItemGroup>

</Project>
